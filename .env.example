# ============================================================================
# RAILWAY PRODUCTION ENVIRONMENT VARIABLES (Copy into Railway -> Variables)
# ============================================================================

# 1. Admin Dashboard Security (Protects `/` and `/approve/*` while keeping `/report/*` public)
ADMIN_PASSWORD=change-this-strong-secret-password

# 2. Your Custom Amazon SES Email Service POST API
SES_WEBHOOK_URL=https://your-ses-service.yourdomain.com/api/send-email
SES_WEBHOOK_API_KEY=your-ses-api-bearer-token
FROM_NAME=Founder @ AegisSaS
FROM_EMAIL=alerts@yourdomain.com

# 3. Public Domain & Stripe Checkout Link
# (Railway automatically injects RAILWAY_PUBLIC_DOMAIN, or set PUBLIC_BASE_URL explicitly)
PUBLIC_BASE_URL=https://audit.yourdomain.com
STRIPE_CHECKOUT_URL=https://buy.stripe.com/your_live_299_pilot_link

# 4. Persistent Volume Mount Path on Railway (Mount a Railway Volume at `/data`)
RAILWAY_VOLUME_MOUNT_PATH=/data

# 5. Autonomous Harvester Interval (Default: 900s = 15 minutes)
CRON_INTERVAL_SECONDS=900
